<%- include ("header") -%>
<header class="hair-banner">
  <!-- the logo-box is an element because it can only live in the block and has no meaning on its own so we write the __ add the block with the element -->
  <!-- <div class="header__logo-box">
    <img src="img/logo.jpg" alt="Logo" class="header__logo" />
  </div> -->
  <div class="header__text-box">
    <!-- the h1 in this case is not an element is block because we could use this class in another block -->
    <h1 class="heading-primary">
      <!-- in this case we use the "--" because is a modifier of the block -->
      <span class="heading-primary--main"> <%= title %> </span>
      <span class="heading-primary--Sub">
        <%= subtitle %>
        <a target="#" href="https://www.facebook.com/sparklesalonboutique/"
          ><i class="social-icon fab fa-facebook"></i></a
        ><a target="#" href="https://www.instagram.com/sparklesalonboutique/"
          ><i class="social-icon fab fa-instagram"></i
        ></a>
      </span>
    </h1>
  </div>
</header>

<main class="hair-view">
  <div class="hair-gallery">
    <figure class="hair-gallery__item">
      <img src="img/hairdresser-haircut.jpg" alt="Photo of hairdresser coloring" class="hair-gallery__photo">
    </figure>
    <figure class="hair-gallery__item">
      <img src="img/hairdresser-washing.jpg" alt="Photo of hairdresser coloring" class="hair-gallery__photo">
    </figure>
    <figure class="hair-gallery__item">
      <img src="img/hairdresser-salon.jpg" alt="Photo of hairdresser coloring" class="hair-gallery__photo">
    </figure>
  </div>

  <div class="overview">
    <h1 class="overview__heading">Sparkle Salon Boutique</h1>
    <div class="overview__stars">
      <svg class="overview__icon-star"><use xlink:href="img/sprite.svg#icon-star"></svg>
      <svg class="overview__icon-star"><use xlink:href="img/sprite.svg#icon-star"></svg>
      <svg class="overview__icon-star"><use xlink:href="img/sprite.svg#icon-star"></svg>
      <svg class="overview__icon-star"><use xlink:href="img/sprite.svg#icon-star_half"></svg>
      <svg class="overview__icon-star"><use xlink:href="img/sprite.svg#icon-star_outline"></svg>
    </div>

    <div class="overview__location">
      <svg class="overview__icon-location"><use xlink:href="img/sprite.svg#icon-location-pin"></svg>
      <a href="https://maps.app.goo.gl/oZAd7QPDkceAYGxP8">
        <button class="btn-inline">Coral Springs, Florida</button>
      </a>
    </div>

    <div class="overview__rating">
      <div class="overview__rating-average">9.0</div>
      <div class="overview__rating-count">429 votes</div>
    </div>
  </div>

  <div class="detail">
    <div class="hair-description">
      <p class="paragraph"><%= hairDesc.description %></p>
      <table>
        <caption class="heading-tertiary u-margin-bottom-small u-text-center">Our Services</caption>
        <tbody>
          <% pricing.forEach(item => { %>
            <tr>
              <td><%= item.service %></td>
              <td><%= item.price %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="recommended">
        <p class="recommended__count">
          Wilma and others recommended this Beauty Salon
        </p>
        <div class="recommended__clients">
          <img src="/img/user-2.jpg" alt="Client 1" class="recommended__photo">
          <img src="/img/user-6.jpg" alt="Client 2" class="recommended__photo">
          <img src="/img/user-3.jpg" alt="Client 3" class="recommended__photo">
          <img src="/img/user-4.jpg" alt="Client 4" class="recommended__photo">
        </div>
      </div>
    </div>
    
    <div class="client-reviews">
      <figure class="hair-review">
        <blockquote class="hair-review__text">
          I've been coloring my hair for years and have visited numerous salons, but the color treatment I received at Sparkle Beauty Salon in Coral Springs is by far the best.
        </blockquote>
        <figcaption class="hair-review__client">
          <img src="/img/user-2.jpg" alt="Sparkle Customer" class="hair-review__photo">
          <div class="hair-review__client-box">
            <p class="hair-review__client-name">Mary Anderson</p>
            <p class="hair-review__client-date">Jan 19th, 2022</p>
          </div>
          <div class="hair-review__rating">8.4</div>
        </figcaption>
      </figure>
      
      <figure class="hair-review">
        <blockquote class="hair-review__text">
          I visited Sparkle Beauty Salon in Coral Springs for the first time and I am beyond impressed! The transformation is unbelievable.
        </blockquote>
        <figcaption class="hair-review__client">
          <img src="/img/user-6.jpg" alt="Sparkle Customer" class="hair-review__photo">
          <div class="hair-review__client-box">
            <p class="hair-review__client-name">Jennifer Wilson</p>
            <p class="hair-review__client-date">Dec 23th, 2021</p>
          </div>
          <div class="hair-review__rating">9.3</div>
        </figcaption>
      </figure> 
      <button class="btn-inline">Show More <span>&rarr;</span></button>  
    </div>
  </div>
  <div class="cta">
    <h2 class="cta__book-now">Hey! what are you waiting for, call now and make an appointment with us!</h2>
    <a href="/about" class="btn-text"> Book Appointment &rarr; </a>
  </div>
</main>
<%- include ("footer") -%>