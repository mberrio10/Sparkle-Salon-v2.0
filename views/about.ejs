<%- include ("header") -%>
<header class="about-banner">
  <!-- the logo-box is an element because it can only live in the block and has no meaning on its own so we write the __ add the block with the element -->
  <div class="header__text-box">
    <!-- the h1 in this case is not an element is block because we could use this class in another block -->
    <h1 class="heading-primary">
      <!-- in this case we use the "--" because is a modifier of the block -->
      <span class="heading-primary--main"><%= titleMain %></span>
      <span class="heading-primary--Sub">
        <%= titleSub %>
        <a target="#" href="https://www.facebook.com/sparklesalonboutique/"
          ><i class="social-icon fab fa-facebook"></i></a
        ><a target="#" href="https://www.instagram.com/sparklesalonboutique/"
          ><i class="social-icon fab fa-instagram"></i
        ></a>
      </span>
    </h1>
  </div>
</header>

<main class="about-view">
  <div class="about-contact">
    <% locations.forEach(location => { %>
      <h3 class="heading-tertiary u-margin-bottom-small u-text-center">
        <%= location.location %>
      </h3>
      <p class="about-address u-text-center u-margin-bottom-small">
        <span class="about-address--street paragraph"><%= location.street %></span>
        <br>
        <span class="about-address--city paragraph"><%= location.city %></span>
      </p>
      <p class="about-contact__number u-text-center" ><a class="about-contact__telephone" href="tel:+9542455619"><%= location.phone %></a></p>
    <% }) %>
    <table>
      <caption class="heading-tertiary u-margin-bottom-small u-text-center">Hours</caption>
      <tbody>
        <% aboutSchedule.forEach(schedule => { %>
          <tr>
            <td><%= schedule.day %></td>
            <td><%= schedule.hours %></td>
          </tr>
        <% }) %>
      </tbody>
      </table>
  </div>
  <div class="about-map">
    <iframe class="my_iFrame" src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d14308.891157543241!2d-80.2718348!3d26.2868767!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0xff292cb763ba6a13!2sSparkle%20Salon!5e0!3m2!1sen!2sus!4v1573933697361!5m2!1sen!2sus" width="600" height="450" frameborder="0" allowfullscreen="" style="border: 0px;"></iframe>
  </div>
</main>

<%- include ("footer") -%>